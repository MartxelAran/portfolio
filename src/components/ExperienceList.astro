---
import { portfolio, experienceUrl, number } from '../lib/portfolio';
import { wrap, sectionSpace, mono, syntax, statusDot } from '../lib/ui';
import SectionHeading from './SectionHeading.astro';
import Tags from './Tags.astro';
---
<section id="experiencia" class:list={[wrap, sectionSpace]} aria-labelledby="experience-title">
  <SectionHeading label="02 / EXPERIENCIA" id="experience-title">De administrar datos<br /><span class={syntax}>a construir plataformas.</span></SectionHeading>
  <div>
    {portfolio.experiences.map((experience, index) => (
      <a href={experienceUrl(experience.slug)} class="experience-row group grid grid-cols-[18px_minmax(0,1fr)] items-center gap-[13px] border-t border-line py-[25px] transition-colors last:border-b hover:bg-hover sm:grid-cols-[22px_minmax(0,1fr)] sm:gap-[15px] sm:py-[33px] md:grid-cols-[25px_minmax(0,1fr)_minmax(0,1fr)_180px] md:gap-5 lg:grid-cols-[40px_minmax(0,1fr)_minmax(0,1.05fr)_200px] lg:gap-6">
        <span class:list={[mono, 'self-start pt-[7px] text-[11px] text-muted']}>{number(index)}</span>
        <div class="min-w-0"><h3 class="text-xl leading-[1.3] tracking-[-.04em] wrap-anywhere sm:text-[23px] md:text-xl lg:text-[23px]">{experience.company}</h3><p class="mt-2 text-xs leading-relaxed text-muted">{experience.role}</p></div>
        <div class="col-start-2 row-start-3 min-w-0 md:col-start-3 md:row-start-1"><p class="max-w-[440px] text-sm leading-[1.8] text-muted md:max-w-[340px]">{experience.summary}</p><Tags items={experience.tags} class="mt-3 gap-1.5" /></div>
        <div class="col-start-2 row-start-2 flex min-w-0 items-center justify-between gap-3.5 sm:gap-5 md:col-start-4 md:row-start-1 md:flex-col md:items-end md:self-stretch">
          <span class:list={['max-w-full font-mono text-[11px] leading-relaxed', experience.current ? 'inline-flex items-start gap-1.5 rounded-[3px] border border-line bg-accent-soft px-2 py-1 text-ink' : 'text-muted']}>
            {experience.current && <span class:list={[statusDot, 'mt-1']} aria-hidden="true"></span>}<span class="min-w-0">{experience.period}</span>
          </span>
          <span aria-hidden="true" class="grid size-[31px] shrink-0 place-items-center rounded border border-line text-lg transition-[background,border-color] group-hover:border-accent group-hover:bg-accent group-hover:text-on-accent sm:size-[35px] sm:text-xl">↗</span>
          <span class="sr-only">Ver experiencia en {experience.company}</span>
        </div>
      </a>
    ))}
  </div>
</section>

---
import type { GetStaticPaths } from 'astro';
import Layout from '../../layouts/Layout.astro';
import ExternalLink from '../../components/ExternalLink.astro';
import Tags from '../../components/Tags.astro';
import { portfolio, homeUrl, projectUrl, experienceUrl, number, url, type Project } from '../../lib/portfolio';
import { wrap, eyebrow, mono, textLink } from '../../lib/ui';

export const getStaticPaths = (() => portfolio.projects.map((project, index) => ({
  params: { slug: project.slug },
  props: { project, next: portfolio.projects[(index + 1) % portfolio.projects.length], index },
}))) satisfies GetStaticPaths;

interface Props { project: Project; next: Project; index: number; }
const { project, next, index } = Astro.props;
const contentHeading = 'text-[27px] leading-[1.3] tracking-[-.035em] sm:text-[30px]';
const sectionClass = 'mt-9 border-t border-line pt-8';
const sidebarLink = 'inline-flex min-h-11 items-center border-b border-line py-2 text-sm text-muted hover:text-ink aria-[current=location]:border-accent-ink aria-[current=location]:text-ink md:-ml-px md:border-b-0 md:border-l-2 md:border-transparent md:py-0 md:pl-4';
const sections = [
  { id: 'contexto', title: 'El problema' },
  { id: 'aportacion', title: 'Mi aportación' },
  { id: 'tecnologias', title: 'Tecnologías' },
  { id: 'flujo', title: 'Flujo del proyecto' },
  { id: 'documentacion', title: 'Documentación y enlaces' },
];
---
<Layout title={`${project.name} — ${portfolio.name}`} description={project.summary} detail>
  <main id="contenido" class={wrap}>
    <a href={`${homeUrl}#proyectos`} class:list={[textLink, 'mt-7 sm:mt-10']}><span aria-hidden="true">←</span> Todos los proyectos</a>

    <section class="pt-8 sm:pt-12" aria-labelledby="project-title">
      <p class={eyebrow}>PROYECTO / {number(index)} · {project.label}</p>
      <h1 id="project-title" class="mt-5 text-[clamp(32px,8vw,64px)] leading-[1.15] tracking-[-.045em] wrap-anywhere">{project.name}<span class="text-keyword" aria-hidden="true">_</span></h1>
      <p class="mt-5 max-w-[960px] text-[24px] leading-[1.4] tracking-[-.035em] text-code-type sm:text-[32px]">{project.title}</p>
      {project.originalTitle && <p lang="eu" class="mt-4 text-sm leading-relaxed text-muted wrap-anywhere">{project.originalTitle}</p>}
      <p class="mt-6 max-w-[78ch] text-base leading-[1.85] text-muted sm:text-lg">{project.description}</p>
      <p class="mt-8 border-y border-line py-5 text-sm leading-relaxed text-muted">{project.institution}</p>
    </section>

    <div class="my-10 grid grid-cols-1 items-start gap-8 md:my-16 md:grid-cols-[180px_minmax(0,1fr)] md:gap-10 lg:grid-cols-[220px_minmax(0,1fr)] lg:gap-[75px]">
      <aside class="case-sidebar md:sticky md:top-10">
        <p class:list={[eyebrow, 'mb-3 md:mb-5']}>EN ESTE PROYECTO</p>
        <nav class="flex flex-wrap gap-x-5 gap-y-2 md:flex-col md:gap-2 md:border-l md:border-line" aria-label="Contenido del proyecto">
          {sections.map((section) => <a href={`#${section.id}`} class={sidebarLink}>{section.title}</a>)}
        </nav>
      </aside>

      <article class="min-w-0">
        <section id="contexto" aria-labelledby="context-title">
          <p class={eyebrow}>EL PUNTO DE PARTIDA</p>
          <h2 id="context-title" class:list={[contentHeading, 'mt-4']}>El problema</h2>
          <p class="mt-5 max-w-[72ch] text-base leading-[1.9] text-muted">{project.problem}</p>
        </section>

        <section id="aportacion" class={sectionClass} aria-labelledby="contribution-title">
          <h2 id="contribution-title" class={contentHeading}>Mi aportación</h2>
          <p class="mt-5 max-w-[72ch] text-base leading-[1.9] text-muted">{project.contribution}</p>
        </section>

        <section id="tecnologias" class={sectionClass} aria-labelledby="technology-title">
          <p class={eyebrow}>LA CAJA DE HERRAMIENTAS</p>
          <h2 id="technology-title" class:list={[contentHeading, 'mt-4']}>Cómo está construido</h2>
          <dl class="mt-7 grid gap-x-7 gap-y-7 sm:grid-cols-2">
            {project.technologyGroups.map((group) => <div class="min-w-0"><dt class="text-sm font-semibold text-ink">{group.title}</dt><dd><Tags items={group.items} class="mt-3" size="large" /></dd></div>)}
          </dl>
        </section>

        <section id="flujo" class={sectionClass} aria-labelledby="flow-title">
          <p class={eyebrow}>FLUJO DEL PROYECTO</p>
          <h2 id="flow-title" class:list={[contentHeading, 'mt-4']}>{project.workflowTitle}</h2>
          <ol class="mt-6 grid gap-4 sm:grid-cols-2">
            {project.workflow.map((step, stepIndex) => <li class="flex items-start gap-3 rounded border border-line bg-soft p-4"><span class:list={[mono, 'pt-0.5 text-code-type']}>{number(stepIndex)}</span><p class="text-sm leading-[1.8]">{step}</p></li>)}
          </ol>
          <p class="mt-4 text-xs leading-relaxed text-muted">{project.workflowCaption}</p>
        </section>

        <section id="documentacion" class={sectionClass} aria-labelledby="documentation-title">
          <h2 id="documentation-title" class={contentHeading}>Documentación y enlaces</h2>
          <p class="mt-5 max-w-[72ch] text-base leading-[1.9] text-muted">{project.evidence}</p>
          <div class="mt-5 flex flex-wrap gap-x-7 gap-y-3">
            {project.document ? (
              <a href={url(encodeURIComponent(project.document))} hreflang="eu" type="application/pdf" target="_blank" rel="noopener noreferrer" class={`${textLink} underline underline-offset-5`}>{project.linkLabel} <span aria-hidden="true">↗</span><span class="sr-only"> (se abre en una pestaña nueva)</span></a>
            ) : project.url && <ExternalLink href={project.url} class={`${textLink} underline underline-offset-5`}>{project.linkLabel}</ExternalLink>}
            {project.demoUrl && <ExternalLink href={project.demoUrl} class={textLink}>Ver web</ExternalLink>}
            {project.experienceSlug && <a href={experienceUrl(project.experienceSlug)} class={textLink}>Ver experiencia <span aria-hidden="true">→</span></a>}
          </div>
        </section>
      </article>
    </div>

    {portfolio.projects.length > 1 && <a href={projectUrl(next.slug)} class="next-project mb-10 flex flex-col gap-4 rounded border border-line border-l-2 border-l-accent bg-soft p-6 transition-colors hover:bg-accent-soft sm:p-9"><span class={eyebrow}>SIGUIENTE PROYECTO</span><span class="flex items-center justify-between gap-5 text-2xl leading-[1.4] tracking-[-.035em] text-code-type wrap-anywhere sm:text-4xl">{next.name}<span aria-hidden="true">→</span></span></a>}
  </main>
</Layout>

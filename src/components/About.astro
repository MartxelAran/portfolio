---
import { portfolio } from '../lib/portfolio';
import { wrap, eyebrow, syntax } from '../lib/ui';
---
<section id="sobre-mi" class:list={[wrap, 'grid grid-cols-1 gap-6 border-t border-line py-9 md:grid-cols-[minmax(0,.8fr)_minmax(0,1.2fr)] md:gap-14 md:py-12']} aria-labelledby="about-title">
  <div>
    <p class:list={[eyebrow, 'text-code-comment']}>SOBRE MÍ</p>
    <h2 id="about-title" class="mt-3 text-2xl leading-[1.35] tracking-[-.04em] sm:text-[28px]">De los datos<br />a las <span class={syntax}>aplicaciones.</span></h2>
  </div>
  <div class="max-w-2xl space-y-4 text-sm leading-[1.85] text-muted sm:text-base">
    {portfolio.about.map((paragraph) => <p>{paragraph}</p>)}
  </div>
</section>

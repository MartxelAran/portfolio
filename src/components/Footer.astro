---
import { portfolio, homeUrl } from '../lib/portfolio';
import { wrap } from '../lib/ui';
import ExternalLink from './ExternalLink.astro';
import ThemeSwitcher from './ThemeSwitcher.astro';
---
<footer class:list={[wrap, 'py-[30px] text-xs text-muted sm:py-[42px]']}>
  <div class="flex flex-wrap items-center justify-between gap-[18px] sm:gap-x-6 sm:gap-y-[15px] md:flex-nowrap">
  <a href={homeUrl} class="basis-full text-[13px] tracking-[-.03em] text-ink sm:basis-auto sm:text-xs">{portfolio.name}<span class="text-[25px] leading-0 text-accent-ink">.</span></a>
  <p class="hidden md:block">Hecho con criterio. Y con código.</p>
  <div class="flex gap-[18px] sm:gap-5 [&_a]:inline-flex [&_a]:min-h-11 [&_a]:items-center [&_a:hover]:underline [&_a:hover]:underline-offset-4">
    <ExternalLink href={portfolio.social.github}>GitHub</ExternalLink>
    <ExternalLink href={portfolio.social.linkedin}>LinkedIn</ExternalLink>
  </div>
  <a class="inline-flex min-h-11 items-center hover:underline hover:underline-offset-4" href="#top">Volver arriba <span aria-hidden="true">↑</span></a>
  </div>
  <div id="apariencia" class="mt-7 hidden flex-col items-start justify-between gap-4 border-t border-line pt-5 js:flex sm:flex-row sm:items-center">
    <div><h2 id="appearance-title" class="text-xs font-normal text-ink">Apariencia</h2><p class="mt-1 text-[11px] text-muted">Tu preferencia se guarda en este navegador.</p></div>
    <ThemeSwitcher />
  </div>
</footer>
<div class="bg-accent text-on-accent">
  <div class:list={[wrap, 'flex min-h-8 items-center justify-between gap-4 py-1 text-[10px]']}>
    <span class="inline-flex items-center gap-2"><svg width="12" height="14" viewBox="0 0 16 18" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><circle cx="4" cy="3" r="2" /><circle cx="12" cy="3" r="2" /><circle cx="4" cy="15" r="2" /><path d="M4 5v8m8-8v2a4 4 0 0 1-4 4H4" /></svg>main</span>
    <span class="hidden sm:inline">{portfolio.location}</span>
    <div class="flex items-center gap-4"><span>UTF-8</span><span data-theme-name>Sistema</span></div>
  </div>
</div>

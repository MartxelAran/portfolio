---
import { portfolio, experienceUrl, number } from '../lib/portfolio';
import { wrap, sectionSpace, mono, syntax, statusDot } from '../lib/ui';
import SectionHeading from './SectionHeading.astro';
import Tags from './Tags.astro';
---
<section id="experiencia" class:list={[wrap, sectionSpace]} aria-labelledby="experience-title">
  <SectionHeading label="02 / EXPERIENCIA" id="experience-title">Mi recorrido<br />en <span class={syntax}>desarrollo.</span><Fragment slot="intro">Del trabajo con bases de datos al desarrollo de aplicaciones web.</Fragment></SectionHeading>
  <div>
    {portfolio.experiences.map((experience, index) => (
      <a href={experienceUrl(experience.slug)} class="experience-row group grid grid-cols-[18px_minmax(0,1fr)_76px] items-center gap-[13px] border-t border-line py-[25px] transition-colors last:border-b hover:bg-soft sm:grid-cols-[22px_1fr_95px] sm:gap-[15px] sm:py-[33px] md:grid-cols-[25px_1fr_1fr_100px] md:gap-5 lg:grid-cols-[40px_1fr_1.05fr_132px] lg:gap-6">
        <span class:list={[mono, 'self-start pt-[7px] text-[11px] text-muted']}>{number(index)}</span>
        <div><h3 class="text-xl leading-[1.3] tracking-[-.04em] wrap-anywhere sm:text-[23px] md:text-xl lg:text-[23px]">{experience.company}</h3><p class="mt-2 text-xs leading-relaxed text-muted">{experience.role}</p></div>
        <div class="col-start-2 md:col-auto"><p class="max-w-[440px] text-sm leading-[1.8] text-muted md:max-w-[340px]">{experience.summary}</p><Tags items={experience.tags} class="mt-3 gap-1.5" /></div>
        <div class="col-start-3 row-span-2 row-start-1 flex flex-col items-end justify-between gap-3.5 self-stretch sm:gap-5 md:col-start-4 md:row-auto">
          <span class:list={['font-mono text-[11px] text-muted', experience.current && 'inline-flex items-center gap-1.5 rounded-[3px] border border-line bg-accent-soft px-2 py-1 text-ink']}>
            {experience.current && <span class={statusDot} aria-hidden="true"></span>}{experience.period}
          </span>
          <span aria-hidden="true" class="grid size-[31px] place-items-center rounded border border-line text-lg transition-[background,border-color] group-hover:border-accent group-hover:bg-accent group-hover:text-on-accent sm:size-[35px] sm:text-xl">↗</span>
          <span class="sr-only">Ver experiencia en {experience.company}</span>
        </div>
      </a>
    ))}
  </div>
</section>

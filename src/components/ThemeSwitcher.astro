---
const modes = [
  { value: 'light', label: 'Claro', title: 'Usar modo claro · Light+' },
  { value: 'dark', label: 'Oscuro', title: 'Usar modo oscuro · Dark+' },
  { value: 'system', label: 'Sistema', title: 'Seguir la apariencia del sistema' },
];
---
<div class="hidden w-fit max-w-full shrink-0 items-center gap-1 rounded border border-line bg-soft p-1 js:flex" role="group" aria-labelledby="appearance-title">
  {modes.map((mode) => (
    <button type="button" data-theme-choice={mode.value} aria-pressed={mode.value === 'system' ? 'true' : 'false'} aria-label={mode.title} title={mode.title} class="inline-flex min-h-11 min-w-11 cursor-pointer items-center justify-center gap-1.5 rounded-[2px] px-2 text-[11px] text-muted transition-colors hover:bg-accent-soft hover:text-ink focus-visible:outline-offset-2 aria-pressed:bg-accent aria-pressed:text-on-accent sm:px-3">
      <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        {mode.value === 'light' ? <><circle cx="12" cy="12" r="4" /><path d="M12 2v2m0 16v2M2 12h2m16 0h2M5 5l1.5 1.5m11 11L19 19M5 19l1.5-1.5m11-11L19 5" /></> : mode.value === 'dark' ? <path d="M20.7 13A9 9 0 0 1 11 3.3 9 9 0 1 0 20.7 13Z" /> : <><rect x="3" y="4" width="18" height="13" rx="1.5" /><path d="M8 21h8m-4-4v4" /></>}
      </svg>
      <span>{mode.label}</span>
    </button>
  ))}
</div>

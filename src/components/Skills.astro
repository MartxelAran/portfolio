---
import { portfolio, number } from '../lib/portfolio';
import { wrap, syntax, mono } from '../lib/ui';
import SectionHeading from './SectionHeading.astro';
const icons: Record<string, string[]> = {
  interface: ['M4 4h16v16H4z', 'M4 9h16', 'M8 6.5h.01M11 6.5h.01', 'm10 13-3 2 3 2m4-4 3 2-3 2'],
  backend: ['M5 4h14v6H5zM5 14h14v6H5z', 'M8 7h.01M8 17h.01', 'M12 7h4m-4 10h4M12 10v4'],
  database: ['M20 6c0 2.2-3.6 4-8 4S4 8.2 4 6s3.6-4 8-4 8 1.8 8 4Z', 'M4 6v12c0 2.2 3.6 4 8 4s8-1.8 8-4V6', 'M4 12c0 2.2 3.6 4 8 4s8-1.8 8-4'],
  workflow: ['M3 3h6v6H3zM15 15h6v6h-6z', 'M9 6h6a3 3 0 0 1 3 3v6', 'm15 12 3 3 3-3', 'M6 9v9h5', 'm9 16 2 2-2 2'],
};
---
<section id="conocimientos" class="border-y border-line bg-soft" aria-labelledby="skills-title">
  <div class:list={[wrap, 'py-12 md:py-16']}>
    <SectionHeading label="01 / MI STACK" id="skills-title">Las piezas con las<br /><span class={syntax}>que construyo.</span><Fragment slot="intro">Una selección de mis herramientas.<br />Su aplicación, en los proyectos de abajo.</Fragment></SectionHeading>
    <div class="grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-4">
      {portfolio.skills.map((skill, index) => <article class="flex min-w-0 flex-col rounded border border-line bg-paper p-5 md:p-6">
        <div class="mb-5 flex items-center justify-between gap-4">
          <svg class="size-7 text-muted" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">{(icons[skill.icon] ?? icons.interface).map((path) => <path d={path} />)}</svg>
          <span class:list={[mono, 'text-code-comment']}>{number(index)}</span>
        </div>
        <h3 class="text-lg leading-[1.4] tracking-[-.035em]">{skill.title}</h3>
        <p class="mt-3 mb-5 text-sm leading-[1.8] text-muted">{skill.description}</p>
        <ul class="mt-auto flex flex-wrap gap-x-3 gap-y-2 border-t border-line pt-4" aria-label={`Tecnologías de ${skill.title.toLowerCase()}`}>
          {skill.tags.map((technology) => <li class="text-xs leading-[1.6] text-ink">{technology}</li>)}
        </ul>
      </article>)}
    </div>
  </div>
</section>
